build() {
  local _meson_options=(
    -Dx11-backend=false # WAYLAND
    -Dwayland-backend=true # WAYLAND
    -Dbroadway-backend=false # -ARCH
    -Dwin32-backend=false # LINUX
    -Dmacos-backend=false # LINUX
    -Dandroid-backend=false # LINUX

    -Dmedia-gstreamer=enabled

    -Dprint-cpdb=disabled # GENTOO
    -Dprint-cups=enabled

    -Dvulkan=enabled

    -Dcloudproviders=disabled # -ARCH
    -Dsysprof=disabled # -ARCH
    -Dtracker=disabled # -ARCH GENTOO

    -Dcolord=enabled # ARCH
    -Df16c=enabled
    -Daccesskit=disabled
    -Dandroid-runtime=disabled # LINUX

    -Dintrospection=disabled # -introspection

    -Ddocumentation=false # -ARCH
    -Dscreenshots=false
    -Dman-pages=true # ARCH

    -Dprofile=default # GENTOO

    -Dbuild-demos=false
    -Dbuild-testsuite=false
    -Dbuild-examples=false
    -Dbuild-tests=false
  )
  CFLAGS+=" -DG_DISABLE_CAST_CHECKS"
  arch-meson "gtk-${pkgver}" build "${_meson_options[@]}"

  meson compile -C build
}

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#${pkgdir}/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

package_gtk4-waypure() {
  optdepends=('evince: Default print preview command')
  provides=("gtk4" 'libgtk-4.so')
  conflicts=("gtk4")
  replaces=("gtk4")

  DESTDIR="${pkgdir}" meson install -C build

  install -Dm644 /dev/stdin "${pkgdir}/usr/share/gtk-4.0/settings.ini" <<END
[Settings]
gtk-icon-theme-name = Adwaita
gtk-theme-name = Adwaita
gtk-font-name = Adwaita Sans 11
END

  install -Dt "${pkgdir}/usr/share/libalpm/hooks" -m644 gtk4-querymodules.hook
  install -D gtk4-querymodules.script "${pkgdir}/usr/share/libalpm/scripts/gtk4-querymodules"

  cd "${pkgdir}"

  # Built by GTK 4, shared with GTK 3
  _pick guic usr/bin/gtk4-update-icon-cache
  _pick guic usr/share/man/man1/gtk4-update-icon-cache.1
}

package_gtk-update-icon-cache-waypure() {
  pkgdesc="GTK icon cache updater"
  provides=("gtk-update-icon-cache")
  conflicts=("gtk-update-icon-cache")
  replaces=("gtk-update-icon-cache")
  depends=(
    bash
    gdk-pixbuf2
    glib2
    glibc
    hicolor-icon-theme
    librsvg
  )

  mv guic/* "${pkgdir}"

  ln -sr "${pkgdir}"/usr/bin/gtk{4,}-update-icon-cache
  ln -sr "${pkgdir}"/usr/share/man/man1/gtk{4,}-update-icon-cache.1

  install -Dt "${pkgdir}/usr/share/libalpm/hooks" -m644 gtk-update-icon-cache.hook
  install -D gtk-update-icon-cache.script \
    "${pkgdir}/usr/share/libalpm/scripts/gtk-update-icon-cache"
}
