# Maintainer: cevdetta
# Contributor: cevdetta

_pkgname=zvbi
pkgname=${_pkgname}-waypure
pkgver=0.2.45
pkgrel=1
pkgdesc="VBI capture and decoding library"
arch=('x86_64')
url="https://github.com/zapping-vbi/zvbi"
license=(
  'GPL-2.0-or-later'
  'GPL-2.0-only'
  'LGPL-2.1-or-later'
  'BSD-2-Clause'
  'MIT'
)
depends=('glibc' 'libgcc' 'libpng')
makedepends=('make')
provides=("${_pkgname}")
conflicts=("${_pkgname}")
replaces=("${_pkgname}")
source=("${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('e6c954fde2a5a635187f19e1ab870a88c1a982012c5f1b33b8f2513e0ab7a50e')

prepare() {
  cd "zvbi-${pkgver}"
  NOCONFIGURE=1 ./autogen.sh
}

build() {
  cd "zvbi-${pkgver}"

  local _make_options=(
    --prefix=/usr
    --sbindir=/usr/bin
    --without-x
    --disable-examples
    --disable-tests
    --disable-doxygen
  )

  ./configure "${_make_options[@]}"

  make
}

package() {
  cd "zvbi-${pkgver}"

  make DESTDIR="${pkgdir}" install
  install -Dm 644 COPYING.md -t "${pkgdir}"/usr/share/licenses/zvbi
}
